<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx 6 IL2CPP plugin. Build: dotnet build -c Release  (copies the DLL into BepInEx\plugins) -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>CustomHeroes</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GameDir>$(MSBuildThisFileDirectory)..\..\..\</GameDir>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>
  <Target Name="CopyToPlugins" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)BepInEx\plugins" />
  </Target>
</Project>
